# /metlife-TEN-Hackathon/Dockerfile.agents
FROM python:3.11-slim
WORKDIR /app

# Install uv
RUN pip install uv

# Copy all necessary files for the package
COPY agents/pyproject.toml agents/uv.lock* agents/README.md ./

# Install dependencies
RUN uv sync --no-dev

# Copy source code and data
COPY agents/src ./src
COPY agents/main.py ./
COPY agents/data ./data

# Create data directory for ChromaDB
RUN mkdir -p /app/data/chroma

EXPOSE 8000

CMD ["uv", "run", "python", "main.py"]
