# /metlife-TEN-Hackathon/Dockerfile.frontend
FROM node:18-alpine AS build
WORKDIR /app

# Railway provides this at build time
ARG RAILWAY_SERVICE_BACKEND_URL

# Copy package files
COPY frontend/package.json frontend/package-lock.json ./

# Install dependencies with legacy peer deps
RUN npm ci --legacy-peer-deps

# Copy application code
COPY frontend/ ./

# Set env vars for React build
ENV REACT_APP_API_URL=https://${RAILWAY_SERVICE_BACKEND_URL}
ENV REACT_APP_API_VERSION=v1

# Build the app with environment variables
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=build /app/build /usr/share/nginx/html

# Copy nginx config
COPY infrastructure/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
